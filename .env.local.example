# Copier ce fichier en .env.local (jamais commité) puis renseigner les valeurs.
# Aucune valeur secrète ne doit figurer dans ce modèle.

# Clé AethexAI (format ae_live_...). Reste côté serveur, jamais dans le navigateur.
# Sans clé, la démo tourne en mode secours (saisie clavier, voix du navigateur).
AETHEX_API_KEY=
AETHEX_BASE_URL=https://api.aethexai.com/api/v1
# Voix ivoirienne. Laisser vide pour la voix par défaut (Adjoua). `npm run aethex:voices` liste les voix disponibles,
# `npm run aethex:test` vérifie la clé et la voix (synthèse puis transcription, consomme quelques crédits).
AETHEX_VOICE_ID=

# Phrase secrète de contrainte, à choisir et à garder hors de git.
# Vide : la détection de contrainte est désactivée (et signalée), jamais de phrase par défaut.
DURESS_PHRASE=

# Clé de signature des webhooks Jèko (fournie par Jèko quand on enregistre le webhook dans leur tableau de bord).
# Vide : une clé aléatoire est générée au démarrage, ce qui convient à la fausse caisse mais fait refuser les vrais webhooks.
JEKO_WEBHOOK_SECRET=

# Vraie caisse Jèko (developer.jeko.africa). Pas de bac à sable : les demandes de paiement sont réelles, essayer avec 5 FCFA.
# La vraie caisse n'est active que si JEKO_MODE=live ET les trois valeurs suivantes sont renseignées ; sinon : fausse caisse.
# `npm run jeko:stores` liste les boutiques (pour JEKO_STORE_ID), `npm run jeko:test` crée une demande de 5 FCFA.
# Les transferts restent simulés (aucun argent ne sort) : le format de contact de l'API de transfert n'est pas documenté.
JEKO_MODE=
JEKO_API_KEY=
JEKO_API_KEY_ID=
JEKO_STORE_ID=
JEKO_BASE_URL=https://api.jeko.africa
# Adresse publique de l'application (retour du client après paiement ; le webhook est PUBLIC_BASE_URL/api/webhook/jeko).
PUBLIC_BASE_URL=http://localhost:3000

# Argus (API locale). Adresse du service, par exemple http://localhost:4040, et clé de licence créée par l'administrateur
# d'Argus (POST /v1/licenses). Sans les deux, le calcul local simplifié sert de moteur. ARGUS_MODE=local l'impose.
ARGUS_URL=
ARGUS_LICENSE_KEY=
ARGUS_MODE=
# Comptes et appareil de démonstration (identifiants fictifs). Laisser vide pour les valeurs par défaut.
ARGUS_ACCOUNT_ID=
ARGUS_DEVICE_ID=
# Délai maximal d'une réponse d'Argus, en millisecondes (200 à 10000, 2000 par défaut).
ARGUS_TIMEOUT_MS=

# 1 = affiche des aides de démonstration. 0 en usage réel.
DEMO_MODE=1

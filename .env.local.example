# Copier ce fichier en .env.local (jamais commité) puis renseigner les valeurs.
# Aucune valeur secrète ne doit figurer dans ce modèle.

# Clé AethexAI (format ae_live_...). Reste côté serveur, jamais dans le navigateur.
# Sans clé, la démo tourne en mode secours (saisie clavier, voix du navigateur).
AETHEX_API_KEY=
AETHEX_BASE_URL=https://api.aethexai.com/api/v1
# Voix ivoirienne. Laisser vide pour la voix par défaut (Adjoua).
AETHEX_VOICE_ID=

# Phrase secrète de contrainte, à choisir et à garder hors de git.
# Vide : la détection de contrainte est désactivée (et signalée), jamais de phrase par défaut.
DURESS_PHRASE=

# Clé de signature des webhooks de la fausse caisse. Vide en démo : une clé aléatoire est générée au démarrage.
JEKO_WEBHOOK_SECRET=

# Argus (API locale). Adresse du service, par exemple http://localhost:4040, et clé de licence créée par l'administrateur
# d'Argus (POST /v1/licenses). Sans les deux, le calcul local simplifié sert de moteur. ARGUS_MODE=local l'impose.
ARGUS_URL=
ARGUS_LICENSE_KEY=
ARGUS_MODE=
# Comptes et appareil de démonstration (identifiants fictifs). Laisser vide pour les valeurs par défaut.
ARGUS_ACCOUNT_ID=
ARGUS_DEVICE_ID=
# Délai maximal d'une réponse d'Argus, en millisecondes (200 à 10000, 2000 par défaut).
ARGUS_TIMEOUT_MS=

# 1 = affiche des aides de démonstration. 0 en usage réel.
DEMO_MODE=1

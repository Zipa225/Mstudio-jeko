# Modèle de docker/argus/.env. Ne mets jamais de vraies valeurs ici : `npm run argus:env` crée le vrai .env
# (ignoré par git) en remplaçant chaque valeur « a_generer » par un secret aléatoire.

POSTGRES_DB=argus
POSTGRES_USER=argus
POSTGRES_PASSWORD=a_generer
REDIS_PASSWORD=a_generer

# Clé partagée entre l'API d'Argus et son moteur ML.
ML_API_KEY=a_generer
JWT_ACCESS_SECRET=a_generer
JWT_REFRESH_SECRET=a_generer

# Premier compte administrateur d'Argus : sert à créer la licence (npm run argus:licence).
ADMIN_EMAIL=admin@jeko-demo.test
ADMIN_PASSWORD=a_generer

# Dossier des sources d'Argus (branche develop). Par défaut : ../true-argus/argus-develop à côté de ce projet.
# ARGUS_DIR=C:/chemin/vers/argus-develop
